<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ranvier-css-compile</ToolCommandName>
    <PackageId>Ranvier.Css.Compile</PackageId>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Description>A .NET tool that extracts the static CSS of typed Ranvier.Css styles applications from an F# project.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ranvier;css;fsharp;build;static-css;dotnet-tool</PackageTags>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Compiler.Service" Version="43.12.403" />
    <ProjectReference Include="../../src/Ranvier.Css.Build/Ranvier.Css.Build.fsproj" />
    <Compile Include="Model.fs" />
    <Compile Include="Project.fs" />
    <Compile Include="CompactMetadata.fs" />
    <Compile Include="CompactEvaluation.fs" />
    <Compile Include="Metadata.fs" />
    <Compile Include="Evaluation.fs" />
    <Compile Include="Extractor.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Ranvier.Css.Compile.Tests" />
  </ItemGroup>
</Project>