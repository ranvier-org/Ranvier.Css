<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <PackageId>Ranvier.Css.Bindings</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.Css.Bindings.Traced</PackageId>
    <Version>0.2.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Description>Specification-generated typed CSS properties and ergonomic helpers for Ranvier.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ranvier;css;fsharp;bindings;typed-css</PackageTags>
    <!--
    Optimised in every configuration. With optimisation off and debug information on, the F# compiler gives each
    module-level value a debugger local in the file's initialiser, and overflows its stack on Generated/Css.fs,
    which holds about 8,900 of them. SDK 10.0.404 fails between 6,000 and 8,000 values in one file.
    -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ranvier.Css/Ranvier.Css.fsproj" />
    <Compile Include="Generated/Css.fs" />
    <None Include="Generated/Css.manifest.json" Pack="true" PackagePath="metadata/" />
    <None Include="../Ranvier.Css/README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>