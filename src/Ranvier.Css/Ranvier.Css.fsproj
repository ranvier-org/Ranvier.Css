<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <PackageId>Ranvier.Css.Core</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.Css.Core.Traced</PackageId>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Description>Runtime for Ranvier.Css: typed CSS values, stylesheets and composable reactive utilities for Ranvier on .NET and Fable. Install Ranvier.Css to also get the generated CSS bindings.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="NativeDisplay.fs" />
    <Compile Include="Values.fs" />
    <Compile Include="GrammarRuntime.fs" />
    <Compile Include="NumericSemantics.fs" />
    <Compile Include="Calculations.fs" />
    <Compile Include="Stylesheet.fs" />
    <Compile Include="Styles.fs" />
    <Compile Include="Utilities.fs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="NativeDisplay.LICENSE.txt" Pack="true" PackagePath="/" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>