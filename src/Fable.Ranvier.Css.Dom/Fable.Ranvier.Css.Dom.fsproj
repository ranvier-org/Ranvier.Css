<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
    <PackageId>Fable.Ranvier.Css.Dom</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.Css.Dom.Traced</PackageId>
    <AssemblyName>Ranvier.Css.Dom</AssemblyName>
    <Version>0.1.0-alpha.1</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Description>Typed Ranvier.Css declarations compiled against the shared Fable DOM contracts.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <WarnOn>$(WarnOn);3390</WarnOn>
    <RanvierDomVersion Condition="'$(RanvierDomVersion)' == ''">0.1.0-alpha.11</RanvierDomVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Ranvier.Css/Ranvier.Css.fsproj" />
    <PackageReference Include="Fable.Ranvier.Dom$(RanvierPackageSuffix)" Version="$(RanvierDomVersion)" />
    <Compile Include="../Ranvier.Css.Dom/StyleDeclaration.fs" Link="StyleDeclaration.fs" />
    <None Include="../Ranvier.Css.Dom/README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
  <Target Name="PackageSharedStyleDeclaration" AfterTargets="CreateStandaloneFableProject">
    <ItemGroup>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs'">
        <PackagePath>fable/%(_PackageFiles.Filename)%(_PackageFiles.Extension)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
    <WriteLinesToFile File="$(NuspecOutputPath)fable/$(MSBuildProjectFile)" Overwrite="true"
                      Lines="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;;  &lt;PropertyGroup&gt;;    &lt;TargetFramework&gt;netstandard2.1&lt;/TargetFramework&gt;;    &lt;AssemblyName&gt;Ranvier.Css.Dom&lt;/AssemblyName&gt;;  &lt;/PropertyGroup&gt;;  &lt;ItemGroup&gt;;    &lt;Compile Include=&quot;StyleDeclaration.fs&quot; /&gt;;  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
</Project>
