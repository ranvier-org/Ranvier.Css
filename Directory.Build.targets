<Project>
    <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
        <DefineConstants>$(DefineConstants);RANVIER_TRACE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(RanvierViewInspect)' == 'true'">
        <DefineConstants>$(DefineConstants);RANVIER_VIEW_INSPECT</DefineConstants>
    </PropertyGroup>
    <Target Name="ValidateLocalRanvier" BeforeTargets="PrepareForBuild" Condition="'$(UseLocalRanvier)' == 'true'">
        <Error Condition="!Exists('$(RanvierRoot)/src/Ranvier.View/Ranvier.View.fsproj')" Text="RanvierRoot must point to a Ranvier.View checkout. Run dotnet fsi build.fsx -- dev local." />
    </Target>
    <Target Name="RefuseTracedPack" BeforeTargets="GenerateNuspec" Condition="'$(RanvierTrace)' == 'true' and !$(PackageId.EndsWith('.Traced'))">
        <Error Text="Traced builds must use a .Traced package ID. Pack with -c Release or RanvierTrace=true." />
    </Target>
    <PropertyGroup Condition="'$(IsExcludedFromRootBuild)' == 'true'">
        <BuildDependsOn>BeforeBuild;AfterBuild</BuildDependsOn>
        <CompileDependsOn />
    </PropertyGroup>
</Project>
